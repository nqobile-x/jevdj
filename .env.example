# Jev (TypeSafe System One). JEV_API_KEY also works.
TYPESAFE_API_KEY=
# Groq: writes the DJ voice lines and speaks them (Orpheus TTS). Optional.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
# Folder with your mp3 / wav / flac / aiff files
MUSIC_DIR=C:\Users\nqobile\Music
# Below this Jev confidence, the rule-based picker decides
JEV_CONFIDENCE_THRESHOLD=0.40
